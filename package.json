    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "start": "astro dev",
    "typecheck": "tsc --noEmit"
  },
  "resolutions": {
    "path-to-regexp": "^6.3.0"
  },
  "dependencies": {
