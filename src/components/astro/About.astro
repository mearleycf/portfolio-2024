---
import { Image } from 'astro:assets'
import mikeIllustration from '@assets/mike_illustration_small.jpg'
---

<section
  id="about"
  class="prose mx-auto text-lightTurquoise-500 prose-h1:text-lightTurquoise-500 prose-h1:mb-2 prose-p:my-2"
>
  <div class="flex flex-col items-center justify-center p-4 pt-8">
    <h1 class="font-display text-4xl">Hi, I'm Mike Earley</h1>
    <p class="text-center font-bold tracking-wider">
      I build things for the web.
    </p>
    <p class="text-center tracking-wide">
      I’m a designer and software engineer in Columbus, Ohio, working at the intersection of UX design and front-end development to build clear, accessible systems. I have extensive experience in AI-Driven Design and Development as well.
    </p>
    <div class="flex items-center justify-center">
      <Image
        src={mikeIllustration}
        alt="Mike Earley Illustration"
        class="outline-3 shadow-border mt-6 h-48 w-48 rounded-full border-2 border-cement-500 object-cover object-center outline-dotted outline-offset-n4 outline-darkBlue-700"
      />
    </div>
  </div>
</section>
