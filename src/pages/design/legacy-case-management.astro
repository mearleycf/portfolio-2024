---
import Layout from '@layouts/BaseLayout.astro'
import staticSvg from '../../assets/static_gradient.svg'
import animatedSvg from '../../assets/animated_gradient_css.svg'

const envSvg = import.meta.env.DEV ? staticSvg.src : animatedSvg.src
---

<style>
  .teal-svg {
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
  }
</style>

<Layout title="Legacy Case Management Redesign | Mike Earley">
  <main
    class="teal-svg relative z-10 min-h-screen pb-16 shadow-xl shadow-darkTeal-600"
    style={`background-color: #0b2228; background-image: url(${envSvg})`}
  >
    <section class="mx-auto flex max-w-5xl flex-col gap-12 px-6 pb-10 pt-12 text-lightTurquoise-500">
      <header class="flex flex-col gap-4">
        <h1 class="font-display text-4xl md:text-5xl">
          Legacy Case Management Redesign
        </h1>
        <p class="max-w-2xl text-base font-semibold tracking-wide md:text-lg">
          Streamlining a mission-critical workflow while preserving speed for
          expert users.
        </p>
        <ul class="flex flex-wrap gap-2 text-xs font-semibold uppercase">
          <li class="rounded-full bg-darkTeal-600/70 px-3 py-1">
            Legacy system
          </li>
          <li class="rounded-full bg-darkTeal-600/70 px-3 py-1">
            Accessibility-first
          </li>
          <li class="rounded-full bg-darkTeal-600/70 px-3 py-1">
            Mixed experience users
          </li>
        </ul>
      </header>

      <section aria-labelledby="legacy-problem" class="flex flex-col gap-4">
        <h2 id="legacy-problem" class="font-display text-2xl">
          The problem
        </h2>
        <p class="max-w-2xl text-sm text-lightTurquoise-600">
          A dense legacy UI created errors during handoffs and slowed new staff
          onboarding.
        </p>
        <figure class="rounded-2xl border border-darkTeal-300/60 bg-darkTeal-800/40 p-6">
          <!-- TODO: Replace with problem overview image -->
          <div class="aspect-[16/9] w-full rounded-xl bg-darkTeal-900/60"></div>
        </figure>
      </section>

      <section
        aria-labelledby="legacy-exploration"
        class="flex flex-col gap-4"
      >
        <h2 id="legacy-exploration" class="font-display text-2xl">
          Exploring solutions
        </h2>
        <p class="max-w-2xl text-sm text-lightTurquoise-600">
          We tested layout and navigation patterns to balance speed with
          clarity.
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          <figure class="rounded-2xl border border-darkTeal-300/60 bg-darkTeal-800/40 p-4">
            <!-- TODO: Replace with comparison concept A -->
            <div class="aspect-[4/3] w-full rounded-xl bg-darkTeal-900/60"></div>
          </figure>
          <figure class="rounded-2xl border border-darkTeal-300/60 bg-darkTeal-800/40 p-4">
            <!-- TODO: Replace with comparison concept B -->
            <div class="aspect-[4/3] w-full rounded-xl bg-darkTeal-900/60"></div>
          </figure>
        </div>
      </section>

      <section aria-labelledby="legacy-decision" class="flex flex-col gap-4">
        <h2 id="legacy-decision" class="font-display text-2xl">
          The decision
        </h2>
        <p class="max-w-2xl text-sm text-lightTurquoise-600">
          We chose a simplified workspace model with clearer hierarchy and
          keyboard-friendly controls.
        </p>
        <figure class="rounded-2xl border border-darkTeal-300/60 bg-darkTeal-800/40 p-6">
          <!-- TODO: Replace with chosen solution image -->
          <div class="aspect-[16/9] w-full rounded-xl bg-darkTeal-900/60"></div>
        </figure>
      </section>

      <section
        aria-labelledby="legacy-results"
        class="flex flex-col gap-4"
      >
        <h2 id="legacy-results" class="font-display text-2xl">
          Resulting design
        </h2>
        <p class="max-w-2xl text-sm text-lightTurquoise-600">
          The final UI supports power users with clear status cues and guided
          decision points.
        </p>
        <div class="flex flex-col gap-4 md:flex-row">
          <figure class="flex-1 rounded-2xl border border-darkTeal-300/60 bg-darkTeal-800/40 p-6">
            <!-- TODO: Replace with desktop design image -->
            <div class="aspect-[16/10] w-full rounded-xl bg-darkTeal-900/60"></div>
          </figure>
          <figure class="md:w-1/3 rounded-2xl border border-darkTeal-300/60 bg-darkTeal-800/40 p-6">
            <!-- TODO: Replace with mobile design image -->
            <div class="aspect-[9/16] w-full rounded-xl bg-darkTeal-900/60"></div>
          </figure>
        </div>
      </section>
    </section>
  </main>
</Layout>
