{
  "name": "astro-portfolio2",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "check": "yarn lint && yarn format && yarn typecheck",
    "dev": "astro dev",
    "fix": "prettier --write --log-level warn . && yarn lint -- --fix",
    "format": "prettier --write './**/*.{js,jsx,json,cjs,mjs,ts,tsx,html,astro}'",
