---
import MobileMenu from '@components/astro/MobileMenu.astro'
import { Icon } from 'astro-icon/components'
---

<style>
  .teal-gradient {
    background-image: linear-gradient(180deg, #257083 0%, #123740 100%);
  }

  .teal-gradient-soft {
    background-image: linear-gradient(
      180deg,
      #257083 0%,
      rgba(18, 55, 64, 0.7) 100%
    );
  }
</style>

<nav
  class="teal-gradient-soft relative z-20 bg-turquoise-600 p-4 font-display text-2xl text-darkTeal-700"
  role="navigation"
>
  <div class="flex justify-between">
    <ul class="hidden md:flex md:space-x-4">
      <li>
        <a
          href="/"
          class="hover:text-paleTaupeBrown-500 block p-2"
          >Developer</a
        >
      </li>
      <li class="relative group">
        <a
          href="/design"
          class="hover:text-paleTaupeBrown-500 block p-2"
          aria-haspopup="true"
          >UX Designer</a
        >
        <ul
          class="absolute left-0 top-full hidden w-64 rounded bg-turquoise-600 pt-2 text-lg shadow-lg group-hover:block group-focus-within:block"
        >
          <li>
            <a
              href="/design/public-service-application"
              class="hover:text-paleTaupeBrown-500 block rounded px-3 py-2"
              >Public Service Application</a
            >
          </li>
          <li>
            <a
              href="/design/legacy-case-management"
              class="hover:text-paleTaupeBrown-500 block rounded px-3 py-2"
              >Legacy Case Management</a
            >
          </li>
        </ul>
      </li>
      <li>
        <a
          href="#about"
          class="hover:text-paleTaupeBrown-500 block p-2"
          >About</a
        >
      </li>
      <li>
        <a
          href="#contact"
          class="hover:text-paleTaupeBrown-500 block p-2"
          >Contact</a
        >
      </li>
    </ul>
    <ul class="hidden md:flex md:space-x-4">
      <li>
        <a
          href="https://github.com/mearleycf"
          class="hover:text-paleTaupeBrown-500 block p-2"
        >
          <Icon name="simple-icons:github" />
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/fivestarnumberone/"
          class="hover:text-paleTaupeBrown-500 block p-2"
        >
          <Icon name="simple-icons:linkedin" />
        </a>
      </li>
    </ul>
  </div>
  <MobileMenu />
</nav>
